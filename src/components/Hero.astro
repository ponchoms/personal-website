---
import type { CvData } from "../i18n/content";

interface Props {
  cv: CvData;
}

const { cv } = Astro.props;
---

<section class="max-w-4xl mx-auto px-6 pt-16 pb-12">
  <div class="flex flex-col md:flex-row items-center md:items-start gap-10">
    <!-- Profile photo with hip tilt -->
    <div class="shrink-0">
      <div
        class="w-44 h-44 rounded-full overflow-hidden border-2 border-taupe-light
               rotate-3 hover:rotate-0 transition-transform duration-500 ease-out"
      >
        <img
          src={`${import.meta.env.BASE_URL}/images/profile.jpg`}
          alt={cv.name}
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
    </div>

    <!-- Name & title — the "business card" moment -->
    <div class="text-center md:text-left">
      <h1 class="font-heading text-4xl md:text-5xl tracking-wide text-ink leading-tight">
        {cv.name}
      </h1>
      <p class="mt-3 text-lg tracking-widest uppercase text-ink-light">
        {cv.title}
      </p>
      <div class="mt-4 flex flex-wrap gap-x-6 gap-y-1 justify-center md:justify-start text-sm text-ink-light">
        <span>{cv.location}</span>
        <a href={`mailto:${cv.email}`} class="hover:text-accent transition-colors underline decoration-taupe-light underline-offset-4">
          {cv.email}
        </a>
        <a href="https://www.linkedin.com/in/alfonsomrno/" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors underline decoration-taupe-light underline-offset-4">
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</section>
