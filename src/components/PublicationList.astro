---
import PublicationCard from "./PublicationCard.astro";
import SectionHeading from "./SectionHeading.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import type { Publication } from "../i18n/content";

interface Props {
  publications: Publication[];
}

const { publications } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Sort by year descending
const sorted = [...publications].sort((a, b) => b.year - a.year);
---

<section class="max-w-4xl mx-auto px-6 py-16">
  <SectionHeading title={t("section.publications")} />
  <div class="divide-y divide-taupe-light">
    {sorted.map((pub) => (
      <PublicationCard pub={pub} />
    ))}
  </div>
</section>
