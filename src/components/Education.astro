---
import SectionHeading from "./SectionHeading.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import type { CvData } from "../i18n/content";

interface Props {
  education: CvData["education"];
}

const { education } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="max-w-4xl mx-auto px-6 py-12">
  <SectionHeading title={t("section.education")} />
  <div class="space-y-8">
    {education.map((item) => (
      <div class="border-l-2 border-taupe-light pl-6">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
          <h3 class="font-heading text-lg text-ink">{item.degree}</h3>
          <span class="text-sm text-ink-light whitespace-nowrap">{item.period}</span>
        </div>
        <p class="text-sm text-ink-light mt-1">{item.institution} — {item.location}</p>
        {item.description && (
          <p class="text-sm text-ink-light mt-2">{item.description}</p>
        )}
      </div>
    ))}
  </div>
</section>
